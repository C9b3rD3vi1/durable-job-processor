APP_ENV=development
LOG_LEVEL=info
HTTP_ADDR=:8080
DATABASE_URL=postgres://jobs:jobs@localhost:5432/jobs?sslmode=disable
DB_MAX_CONNS=10
DB_MIN_CONNS=0
DB_CONNECT_TIMEOUT=5s
AUTO_MIGRATE=false
SHUTDOWN_TIMEOUT=15s
WORKER_CONCURRENCY=4
POLL_INTERVAL=1s
LEASE_DURATION=60s
HEARTBEAT_INTERVAL=15s
HANDLER_TIMEOUT=30s
RETRY_BASE_DELAY=5s
RETRY_MAX_DELAY=15m
RECOVERY_INTERVAL=30s
MAX_ATTEMPTS=5
MAX_PAYLOAD_BYTES=262144
TENANT_MAX_OUTSTANDING_JOBS=1000
TENANT_RATE_LIMIT_PER_MINUTE=600
TENANT_SUBMIT_RATE_LIMIT_PER_MINUTE=120

# webhook.deliver egress: zero-value policy allows any PUBLIC http(s) host.
# WEBHOOK_ALLOWED_HOSTS is an optional comma-separated allow-list; ".example.com"
# also permits subdomains. Never enable WEBHOOK_ALLOW_PRIVATE_IPS in production;
# it exists only for local development and tests. Startup rejects it when
# APP_ENV is production, prod or live.
WEBHOOK_ALLOWED_HOSTS=
WEBHOOK_ALLOW_PRIVATE_IPS=false

# Metrics are served by both API and worker on a dedicated listener.
# Loopback binding is private by default. Binding to :9090 or another routable
# interface requires METRICS_TOKEN and Bearer authentication. When running both
# binaries locally, give each a distinct METRICS_ADDR (for example 9090/9091).
METRICS_ENABLED=true
METRICS_ADDR=127.0.0.1:9090
METRICS_TOKEN=

# API keys are provisioned separately with cmd/apikey after migrations.
