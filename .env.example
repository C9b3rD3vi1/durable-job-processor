APP_ENV=development
LOG_LEVEL=info
HTTP_ADDR=:8080
DATABASE_URL=postgres://jobs:jobs@localhost:5432/jobs?sslmode=disable
DB_MAX_CONNS=10
DB_MIN_CONNS=0
DB_CONNECT_TIMEOUT=5s
AUTO_MIGRATE=false
SHUTDOWN_TIMEOUT=15s
WORKER_CONCURRENCY=4
POLL_INTERVAL=1s
LEASE_DURATION=60s
HEARTBEAT_INTERVAL=15s
HANDLER_TIMEOUT=30s
RETRY_BASE_DELAY=5s
RETRY_MAX_DELAY=15m
RECOVERY_INTERVAL=30s
MAX_ATTEMPTS=5
MAX_PAYLOAD_BYTES=262144

# API keys are provisioned separately with cmd/apikey after migrations.
